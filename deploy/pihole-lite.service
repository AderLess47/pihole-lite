[Unit]
Description=pihole-lite DNS-Sinkhole
Documentation=https://github.com/AderLess47/pihole-lite
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pihole-lite
Group=pihole-lite
WorkingDirectory=/var/lib/pihole-lite
ExecStart=/usr/local/bin/pihole-lite --config /etc/pihole-lite/config.toml

# Port 53 ohne root: nur diese eine Capability, sonst nichts.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s

# Der Gravity-Cache liegt im Arbeitsverzeichnis und ist der einzige Pfad,
# in den geschrieben wird.
StateDirectory=pihole-lite
StateDirectoryMode=0750

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
